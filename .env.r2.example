# Copy to .env.r2 and replace every replace-with-* placeholder with your own R2 settings.
# Percent-encode URI query values, including the endpoint and credentials.
LPC_STORAGE_URI='s3://replace-with-bucket?endpoint=https%3A%2F%2Freplace-with-account-id.r2.cloudflarestorage.com&region=auto&access_key_id=replace-with-access-key-id&secret_access_key=replace-with-secret-access-key'
# Only the HTTP server needs this application token; the CLI ignores it.
LPC_API_TOKEN=replace-with-a-secret
LPC_UPLOAD_URL_TTL_SECONDS=300
LPC_DOWNLOAD_URL_TTL_SECONDS=3600
