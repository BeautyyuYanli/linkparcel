# OpenDAL URI for a private backend with the required capabilities.
OMP_STORAGE_URI=service://replace-with-backend-configuration
OMP_API_TOKEN=replace-with-a-secret
OMP_UPLOAD_URL_TTL_SECONDS=300
OMP_DOWNLOAD_URL_TTL_SECONDS=3600

# Used by the CLI; the server ignores this setting.
OMP_API_URL=http://127.0.0.1:59000

# Used only by compose.yaml's bundled MinIO. Keep these values URL-safe because
# compose.yaml embeds them in the OpenDAL URI.
MINIO_ROOT_USER=ompdev
MINIO_ROOT_PASSWORD=omp-minio-password
MINIO_BUCKET=omp
