# OpenDAL URI for a private backend with the required capabilities.
LPC_STORAGE_URI=service://replace-with-backend-configuration
# Only the HTTP server needs this application token; the CLI ignores it.
LPC_API_TOKEN=replace-with-a-secret
LPC_UPLOAD_URL_TTL_SECONDS=300
LPC_DOWNLOAD_URL_TTL_SECONDS=3600

# Used only by compose.yaml's bundled SeaweedFS mini. Keep these values URL-safe because
# compose.yaml embeds them in the OpenDAL URI.
AWS_ACCESS_KEY_ID=lpcdev
AWS_SECRET_ACCESS_KEY=lpc-seaweedfs-password
S3_BUCKET=lpc
